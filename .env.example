# DS Vision Web Backend environment template
# Copy this file to .env and replace every CHANGE_ME value before running with Docker Compose.

# PostgreSQL
# Use postgres:5432 inside docker-compose. Use localhost:5433 when running the app on the host.
PG_HOST=postgres
PG_PORT=5432
PG_HOST_PORT=5433
PG_NAME=ds_backend
PG_USER=backend
PG_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# JWT
# Must be at least 64 characters for HS256 signing.
JWT_SECRET=CHANGE_ME_64_CHARS_MIN_CHANGE_ME_64_CHARS_MIN_CHANGE_ME_64_CHARS
# PEM private key escaped as a single line with \n separators. Used only for short-lived service JWTs sent to AI Server.
JWT_RSA_PRIVATE_KEY=CHANGE_ME_RSA_PRIVATE_KEY_PEM_ESCAPED

# AI server integration
AI_SERVER_ENABLED=false
AI_SERVER_URL=http://ai-server:8000
AI_QUERY_TIMEOUT_MS=130000

# Web frontend CORS allow-list
# Comma-separated origins. Do not use wildcard in production.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Initial/override ADMIN account.
# If ADMIN_PASSWORD is blank, the Flyway seed account remains unchanged.
ADMIN_EMAIL=admin@ds-vision.local
ADMIN_PASSWORD=
ADMIN_NAME=관리자

# Application
# APP_PORT is the host port exposed by docker compose. The container listens on 8080.
# Graceful shutdown is enabled in application.yml with a 30 second shutdown phase timeout.
APP_PORT=8080
LOG_LEVEL=INFO
